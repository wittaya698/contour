# CLI scratch: last-build.log and report.json, written for every command (ADR 0012)
.contour/

# Models do not live in this repo at all (ADR 0015). This is belt and braces:
# a stray models/ on disk was once swept in by `git add -A` and had to be
# rewritten out, so the path stays ignored even though nothing should create it.
models/

# Model spaces sited under the toolkit (ADR 0015, amended). Each is its own git
# repository, so `git add -A` would record it as a gitlink rather than content —
# a path to a model in a repo that must carry none. Ignored so it cannot.
project/

# The fixture's build output. A model space carries its own ignore rules.
fixtures/*/out/

# Your personal working file: links the generated asset, holds materials/lights/camera
work/

# The console environment (ADR 0019). Per checkout, because the console is
# version-bound to the `lib/` it imports; nobody else's copy is interchangeable.
.venv/

# Editor-local settings. Yours, like `work/` — and a checked-in one here would
# be wrong as well as personal: it names a test runner, and this suite is
# unittest through `contour selftest`, with `console/requirements.txt` the only
# dependency the toolkit has.
.vscode/

# Blender + Python noise
*.blend1
*.blend2
__pycache__/
*.pyc
.DS_Store
