# CLI scratch: last-build.log and report.json, written for every command (ADR 0012)
.contour/

# Generated output — derivable from build.py. The tracked copy of a deliverable
# is models/<v>/release/v<N>/, which these patterns must not catch (ADR 0013).
models/*/out/
models/*/exports/
fixtures/*/out/

# Your personal working file: links the generated asset, holds materials/lights/camera
work/

# Blender + Python noise
*.blend1
*.blend2
__pycache__/
*.pyc
.DS_Store
