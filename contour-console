#!/usr/bin/env python3
"""The console: the page that drives a run (ADR 0019, decisions 2, 34, 23).

Its own executable and not `contour console`, because the two names say what the
install boundary is at the moment somebody meets it: `contour` needs nothing,
`contour-console` needs an environment. This file is the half that needs
nothing — stdlib only, so it can be run and can explain itself on a bare clone.
It finds the console interpreter and hands over; everything that may import a
dependency lives under `console/`.
"""
import os
import signal
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
from lib.enter import MAKE_IT, interpreter    # noqa: E402  stdlib-only, as is this file

USAGE = """contour-console            drive a run from the browser, in this space
  --no-browser             serve, print the URL, and open nothing
  --begin new-space        start the run on the new-space flow, as the lobby does
  --begin variation --of <space>
                           the same, pointing at <space>'s spec and build for
                           reference; nothing of it is copied
  --request <prose> [--requester <who>]
                           an unattended run, as `contour request` starts one;
                           it ends with its run unless a page is open
  $CONTOUR_CONSOLE_PYTHON  the interpreter to run under (default .venv/bin/python)
  $CONTOUR_CONSOLE_IDLE    seconds of nothing happening before the run ends
"""


def space():
    """The model space this was typed in, or None. The walk-up rule is the
    launcher's, imported rather than restated: two definitions of what a space
    is would be two things to keep in step about a question with one answer."""
    from lib import space as space_lib
    return space_lib.find()


def handover(python, project):
    """Run the console under its own interpreter, as a child and not an exec,
    so this process stays the one the terminal is talking to: Ctrl-C reaches
    both, and the process tree reads `contour-console -> contour -> Blender`
    the way ADR 0019 describes it.
    """
    import subprocess
    from lib import signals               # stdlib-only by test (ADR 0019, 32)
    env = dict(os.environ, CONTOUR_ROOT=str(ROOT), CONTOUR_PROJECT=str(project),
               PYTHONPATH=str(ROOT), PYTHONDONTWRITEBYTECODE="1")
    child = subprocess.Popen([str(python), "-m", "console.server", *sys.argv[1:]],
                             cwd=str(ROOT), env=env)

    # SIGTERM is what anything that is not a person sends — a harness tidying
    # up, a supervisor, `kill` — and SIGHUP is what a closed terminal sends.
    # Neither was handled, so the default killed this process where it stood
    # and left the server reparented to init, port still bound and the space
    # still held (issue 27).
    signals.raising(signal.SIGTERM, signal.SIGHUP)
    while True:
        try:
            return child.wait()
        except (KeyboardInterrupt, signals.Arrived) as which:
            # Forward and wait, rather than let this process die and leave the
            # child where it stands: the console has a port to close and a run
            # whose hold on the space has to be given back, and dying releases
            # neither. The child is sent the signal that arrived, because what
            # it means to the person who sent it is the same either side. A
            # terminal Ctrl-C already reached both, so that one arrives second
            # and changes nothing; the other two reached only this process.
            number = signals.number(which)
            child.send_signal(number)
            try:
                return child.wait(timeout=10)
            except subprocess.TimeoutExpired:
                child.kill()                  # it had its chance
                return 128 + number
            except (KeyboardInterrupt, signals.Arrived):
                continue                      # somebody is impatient; so wait


def main():
    if {"-h", "--help", "help"} & set(sys.argv[1:]):
        print(USAGE, end="")                  # before the environment check: a
        return 0                              # reader asking what this is has none
    python = interpreter()
    if not python.exists():
        print(f"contour-console: no console environment at {python}.\n"
              f"  The console needs an interpreter the launcher does not.\n"
              f"  Make one, from {ROOT}:\n"
              f"    {MAKE_IT}", file=sys.stderr)
        return 4
    project = space()
    if project is None:
        print(f"contour-console: not in a model space.\n"
              f"  No .contour/project found here or above {Path.cwd()}.\n"
              f"  cd into a model space — the directory holding spec.yaml.",
              file=sys.stderr)
        return 2
    return handover(python, project)


if __name__ == "__main__":
    sys.exit(main())
