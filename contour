#!/usr/bin/env python3
"""Contour CLI: the only sanctioned way to run Blender (ADR 0008).

Run the model commands from inside a model space — the directory holding
spec.yaml, found by walking up for .contour/project (ADR 0015). A model is
never named on the command line: you are standing in it.

Blender's stdout (~2-5k tokens of banner and chatter per run) goes to
.contour/last-build.log. The Blender side writes a JSON report; this wrapper
prints only its terse `lines`. Stdlib only: no venv, no yaml.

    contour check                 build + verify
    contour render                4-view sheet -> sheet.png, + mask, + mark badges
    contour export                .glb + round-trip re-measure
    contour api <symbol>...       real signature from the installed Blender
    contour measure <ref> ...     real pixel geometry from a reference image
    contour measure --span <m>    read the distance two pins on a reference mean
    contour canvas                the sheet and the references in a browser, to mark on
    contour mark --part <p> "..."  pin a finding on the sheet, for the user to see
    contour run <cmd>...          hold this space for one run, then release it
    contour selftest              fixture pipeline test
    contour install-hooks         install the pre-push guard (ADR 0011)
    contour init <name>           create a model space here
    contour doctor                is this space in step with the toolkit
    contour spaces [name]         list model spaces, or print one's path
    contour intents               the call categories a gate can ask about
    contour hook <name>           run a guard; for hooks to call, not you
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent
BLENDER = os.environ.get("BLENDER", "/Applications/Blender.app/Contents/MacOS/Blender")
MARKER = Path(".contour") / "project"
TIMEOUT_S = 300
USAGE = __doc__.split("\n\n", 2)[2].rstrip()


def find_project(start=None):
    """The model space containing `start`, or None. Walks up for
    .contour/project, the way git walks up for .git.

    The marker is that file and not the .contour/ directory: the toolkit has a
    .contour/ too, for its own logs, and must never be mistaken for a space.
    """
    here = (Path(start) if start else Path.cwd()).resolve()
    for d in (here, *here.parents):
        if (d / MARKER).is_file():
            return d
    return None


PROJECT = find_project()
OUT = (PROJECT or ROOT) / ".contour"     # logs sit with whatever the command is about
LOG = OUT / "last-build.log"
REPORT = OUT / "report.json"


def stage(args, first=True):
    """Run one Blender process. Returns its report dict, never raises."""
    OUT.mkdir(parents=True, exist_ok=True)
    REPORT.unlink(missing_ok=True)
    cmd = [BLENDER, "--background", "--factory-startup", "--python-exit-code", "1",
           "--python", str(ROOT / "lib" / "entry.py"), "--", *args]
    env = dict(os.environ, CONTOUR_ROOT=str(ROOT), CONTOUR_REPORT=str(REPORT),
               PYTHONDONTWRITEBYTECODE="1")
    if PROJECT:
        env["CONTOUR_PROJECT"] = str(PROJECT)
    t0 = time.time()
    with open(LOG, "w" if first else "a") as log:
        log.write(f"$ {' '.join(args)}\n")
        log.flush()
        try:
            rc = subprocess.run(cmd, stdout=log, stderr=subprocess.STDOUT, env=env,
                                timeout=TIMEOUT_S).returncode
        except subprocess.TimeoutExpired:
            return {"ok": False, "lines": [f"FAIL blender timed out after {TIMEOUT_S}s"]}
        except FileNotFoundError:
            return {"ok": False, "lines": [f"FAIL no Blender at {BLENDER} (set $BLENDER)"]}
    if REPORT.exists():
        rep = json.loads(REPORT.read_text())
    else:
        tail = LOG.read_text().strip().splitlines()[-8:]
        rep = {"ok": False, "lines": [f"FAIL blender exit {rc}, no report", *tail]}
    rep["secs"] = round(time.time() - t0, 1)
    return rep


def emit(rep):
    print("\n".join(rep["lines"]))
    if not rep["ok"] and "secs" in rep:   # only Blender stages write that log
        print(f"(full log: {LOG})")
    return 0 if rep["ok"] else 1


def need_project(cmd):
    """Say so plainly. Never fall back to the toolkit's own directory: a stray
    `contour check` elsewhere would then build something unexpected (ADR 0015)."""
    print(f"contour {cmd}: not in a model space.\n"
          f"  No {MARKER} found here or above {Path.cwd()}.\n"
          f"  cd into a model space — the directory holding spec.yaml.",
          file=sys.stderr)
    return 2


REVISION = re.compile(r"^revision:\s*(\d+)\s*$", re.M)


def spec_revision(text):
    """The contract's revision number. Absent means 0, so a spec written before
    ADR 0016 is revision 0 and its first correction is 1. Anchored at column 0,
    so the word inside an indented block scalar is not mistaken for the field."""
    m = REVISION.search(text or "")
    return int(m.group(1)) if m else 0


def check_revision():
    """A spec may change; it may not change silently (ADR 0016).

    Rule 1 used to make an unapproved spec edit impossible. Now it makes one
    noisy, and this is the noise: content that differs from HEAD without a bump
    is the one case where a change nobody approved looks different from a
    change that was. Returns None when there is nothing to say — this runs on
    every model command, so it is silent on success and costs nothing.
    """
    spec = PROJECT / "spec.yaml"
    if not spec.exists():
        return None
    head = subprocess.run(["git", "-C", str(PROJECT), "show", "HEAD:spec.yaml"],
                          capture_output=True, text=True)
    if head.returncode != 0:      # untracked, or no commit yet: creation is not mutation
        return None
    now = spec.read_text(encoding="utf-8")
    if now == head.stdout:
        return None
    was, is_ = spec_revision(head.stdout), spec_revision(now)
    if is_ > was:
        return None
    return {"ok": False, "lines": [
        f"FAIL revision  spec.yaml differs from HEAD, revision still {is_}",
        "  The spec is the user's intent. It may be revised once they have",
        "  confirmed the change, never quietly (rule 1, ADR 0016).",
        f"  confirmed -> set revision: {was + 1}   not confirmed -> git checkout -- spec.yaml"]}


def say_marks(code):
    """What the canvas has to say, after the check has said its piece (ADR 0018).

    Never red and never part of the exit code: red means the build violates the
    spec, and a mark exists precisely because the spec did not catch the thing.
    Silent at zero, so it costs nothing on the command run dozens of times a
    session.
    """
    sys.path.insert(0, str(ROOT))
    from lib import marks
    line = marks.status_line(PROJECT / marks.NAME)
    if line:
        print(line)
    return code


def held_by(rec):
    """Who has the space, in one line the user can act on."""
    return f"pid {rec.get('pid', '?')} running {rec.get('command', 'something')}"


def hold(command, doing=None):
    """Take the space for the length of this call, or refuse and say who has it.

    `command` is what *this* caller is; `doing` is what goes on the record, so
    the next caller's refusal can name a process it could go and look at.
    """
    sys.path.insert(0, str(ROOT))
    from lib import lock
    try:
        record = lock.take(PROJECT, doing or command,
                           run=os.environ.get("CONTOUR_RUN"))
        if record.get("took_over"):
            print(f"ok   lock    took over the hold left by "
                  f"{held_by(record['took_over'])}, which is gone")
        return record
    except Exception as e:
        rec = getattr(e, "record", None)
        if rec is None:
            raise
        print(f"contour {command}: this space is held by {held_by(rec)}.",
              file=sys.stderr)
        return None


def free(record):
    """Release the space, whatever happened — a failed or interrupted run that
    kept the lock would wedge the space until somebody found the file."""
    sys.path.insert(0, str(ROOT))
    from lib import lock
    lock.release(PROJECT, record)


def run_held(rest):
    """`contour run <cmd>...`: one run, holding the space while it lasts.

    The unit the lock is scoped to. What races is the `build.py` editing
    *between* builds, so a build-scoped lock would look like a fix and not be
    one — the holder here is the whole session, whatever it does.
    """
    record = hold("run", " ".join(["run", *rest]))
    if record is None:
        return 3
    env = dict(os.environ, CONTOUR_RUN=record["run"])
    try:
        return subprocess.run(rest, env=env).returncode
    except KeyboardInterrupt:
        return 130
    finally:
        free(record)


def build_path(cmd):
    """check / render / export: the commands that write `out/` and read the
    spec, and so the ones a second run may not join in on."""
    drifted = check_revision()
    if drifted:
        return emit(drifted)
    if cmd != "export":
        code = emit(stage(["build" if cmd == "check" else cmd]))
        return say_marks(code) if cmd == "check" else code
    rep = stage(["export"])
    if not rep["ok"]:
        return emit(rep)
    rt = stage(["roundtrip"], first=False)
    rt["lines"] = rep["lines"] + rt["lines"]
    return emit(rt)


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd in ("check", "render", "export") and not rest:
        if not PROJECT:
            return need_project(cmd)
        record = hold(cmd)
        if record is None:
            return 3
        try:
            return build_path(cmd)
        finally:
            free(record)
    if cmd == "api" and rest:
        return emit(stage(["api", *rest]))
    if cmd == "canvas" and not rest:
        if not PROJECT:
            return need_project(cmd)
        sys.path.insert(0, str(ROOT))
        from lib import canvas, marks
        out = PROJECT / "out"
        return emit(canvas.serve(PROJECT / "sheet.png", PROJECT / marks.NAME,
                                 out / "mask.png", out / "parts.json",
                                 resolve=lambda: stage(["resolve"]),
                                 refs=PROJECT / "refs"))
    if cmd == "mark" and rest:
        if not PROJECT:
            return need_project(cmd)
        sys.path.insert(0, str(ROOT))
        from lib import agent, marks
        return emit(agent.command(PROJECT / marks.NAME, rest,
                                  PROJECT / "out" / f"{PROJECT.name}.blend",
                                  PROJECT / "out" / "parts.json"))
    if cmd == "measure" and rest:
        if not PROJECT:
            return need_project(cmd)
        return emit(stage(["measure", *rest]))
    if cmd == "run" and rest:
        if not PROJECT:
            return need_project(cmd)
        return run_held(rest)
    if cmd == "selftest" and not rest:
        return emit(stage_selftest())
    if cmd == "install-hooks" and not rest:
        return emit(install_hooks())
    if cmd == "intents" and not rest:
        sys.path.insert(0, str(ROOT))
        from lib import intent
        print("\n".join(intent.categories()))
        return 0
    if cmd == "hook" and rest:
        return run_hook(rest[0], rest[1:])
    if cmd == "init" and len(rest) == 1:
        return emit(init(rest[0]))
    if cmd == "doctor" and not rest:
        if not PROJECT:
            return need_project(cmd)
        return emit(doctor())
    if cmd == "spaces" and len(rest) <= 1:
        return emit(spaces(rest[0] if rest else None))
    print(USAGE, file=sys.stderr)
    return 2


SCAFFOLD = ("CLAUDE.md", ".claude/settings.json",
            ".claude/skills/build-model/SKILL.md",
            ".claude/skills/build-model/references/bpy-recipes.md",
            ".claude/skills/release-model/SKILL.md")


def toolkit_commit():
    r = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "--short", "HEAD"],
                       capture_output=True, text=True, timeout=10)
    return r.stdout.strip() if r.returncode == 0 else "unknown"


def init(name):
    """Create a model space (ADR 0015): its own directory, its own git repo.

    Copies only what the agent must read from the working directory. The
    guards are never copied — settings.json and the pre-push stub call the
    installed toolkit, so there is one implementation and nothing to drift.
    """
    space = (Path.cwd() / name).resolve()
    if (space / MARKER).exists():
        return {"ok": False, "lines": [f"FAIL {space} is already a model space"]}
    tpl = ROOT / "templates" / "space"
    (space / ".contour").mkdir(parents=True, exist_ok=True)
    (space / "refs").mkdir(exist_ok=True)
    kept = []
    for rel in SCAFFOLD:
        dst = space / rel
        if dst.exists():                  # adopting a directory: never clobber
            kept.append(rel)
            continue
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.write_text((tpl / rel).read_text().replace("<NAME>", space.name))
    if not (space / ".gitignore").exists():
        (space / ".gitignore").write_text((tpl / "gitignore").read_text())
    else:
        kept.append(".gitignore")
    (space / ".contour" / "project").write_text(
        "# Contour model space (ADR 0015). This file is the marker: keep it tracked.\n"
        f"toolkit: {toolkit_commit()}\n"
        f"toolkit_path: {ROOT}\n"
        f"created: {time.strftime('%Y-%m-%d')}\n")
    lines = [f"ok   {space}"]
    r = subprocess.run(["git", "init", "-q", str(space)], capture_output=True, text=True)
    if r.returncode != 0:
        return {"ok": False, "lines": [f"FAIL git init: {r.stderr.strip()}"]}
    hooks = subprocess.run(["git", "-C", str(space), "rev-parse", "--git-path", "hooks"],
                           capture_output=True, text=True).stdout.strip()
    dst = (space / hooks).resolve()
    dst.mkdir(parents=True, exist_ok=True)
    (dst / "pre-push").write_bytes((tpl / "pre-push").read_bytes())
    (dst / "pre-push").chmod(0o755)
    lines += ["ok   git init, pre-push stub installed (this space is never pushed)",
              f"ok   scaffolding copied from toolkit {toolkit_commit()}"]
    if kept:
        lines.append(f"kept {len(kept)} existing file(s) untouched: {', '.join(kept)}")
    lines += [
              "",
              "next: write spec.yaml (schema: %s)" % (ROOT / "schema" / "spec.schema.yaml"),
              "      put the user's reference images in refs/",
              "      write build.py, then run: contour check"]
    return {"ok": True, "lines": lines}


def doctor():
    """Is this space still in step with the toolkit, and still unpushable."""
    tpl = ROOT / "templates" / "space"
    lines, ok = [], True
    for rel in SCAFFOLD:
        here, there = PROJECT / rel, tpl / rel
        if not here.exists():
            lines.append(f"MISS {rel} — run contour init in a fresh dir to see it")
            ok = False
        elif here.read_text() != there.read_text().replace("<NAME>", PROJECT.name):
            lines.append(f"DRIFT {rel} — differs from the toolkit's template")
            ok = False
        else:
            lines.append(f"ok   {rel}")
    marker = (PROJECT / ".contour" / "project").read_text()
    was = next((l.split(":", 1)[1].strip() for l in marker.splitlines()
                if l.startswith("toolkit:")), "unknown")
    now = toolkit_commit()
    lines.append(f"{'ok  ' if was == now else 'NOTE'} toolkit {was}"
                 + ("" if was == now else f" -> {now} since this space was created"))
    remotes = subprocess.run(["git", "-C", str(PROJECT), "remote"],
                             capture_output=True, text=True).stdout.split()
    if remotes:
        lines.append(f"WARN this space has a remote ({', '.join(remotes)}); it is never pushed")
        ok = False
    hooks = subprocess.run(["git", "-C", str(PROJECT), "rev-parse", "--git-path", "hooks"],
                           capture_output=True, text=True).stdout.strip()
    if not (PROJECT / hooks / "pre-push").exists():
        lines.append("WARN no pre-push stub — nothing stops a push from here")
        ok = False
    if not shutil.which("contour"):
        lines.append("WARN `contour` is not on PATH: the spec guard in "
                     ".claude/settings.json cannot run,")
        lines.append(f"     so rule 1 is unenforced here. Fix, into any dir on PATH:")
        lines.append(f"       ln -s {ROOT / 'contour'} ~/.local/bin/contour")
        ok = False
    lines.append(f"     toolkit at {ROOT}")
    return {"ok": ok, "lines": lines}


def run_hook(name, rest):
    """Run a guard out of tools/hooks/ (ADR 0015).

    A model space never copies these; its settings.json and its pre-push stub
    call this, so the guard is always the installed version and there is
    nothing to drift. exec, so stdin, stdout and the exit code pass straight
    through to whatever invoked the hook.
    """
    if name == "pre-push" and PROJECT:
        print("refused: a model space is never pushed (ADR 0011, ADR 0015).\n"
              "  to share a model: contour export, then hand over the .glb",
              file=sys.stderr)
        return 1
    script = {"spec": "guards/spec.py", "pre-push": "hooks/pre-push"}.get(name)
    if not script:
        print(f"contour hook: no guard named {name!r}", file=sys.stderr)
        return 2
    os.execv(str(ROOT / "tools" / script), [script, *rest])
    return 2                                          # unreachable; exec replaces us


def install_hooks():
    """Copy tools/hooks/* into this checkout's hooks dir (ADR 0011).

    Deliberately not core.hooksPath: that resolves inside the working tree, so
    checking out a variant branch that predates the hook would remove it from
    disk and the guard would silently cease to exist.
    """
    src = ROOT / "tools" / "hooks"
    hooks = [h for h in sorted(src.glob("*")) if h.is_file()]
    if not hooks:
        return {"ok": False, "lines": [f"FAIL no hooks in {src.relative_to(ROOT)}"]}
    try:
        r = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "--git-path", "hooks"],
                           capture_output=True, text=True, timeout=10, check=True)
    except Exception as e:
        return {"ok": False, "lines": [f"FAIL not a git checkout ({e})"]}
    dst = (ROOT / r.stdout.strip()).resolve()
    dst.mkdir(parents=True, exist_ok=True)
    lines = []
    for h in hooks:
        t = dst / h.name
        t.write_bytes(h.read_bytes())
        t.chmod(0o755)
        lines.append(f"ok   {h.name}")
    override = subprocess.run(["git", "-C", str(ROOT), "config", "--get", "core.hooksPath"],
                              capture_output=True, text=True, timeout=10).stdout.strip()
    if override:
        lines.append(f"WARN core.hooksPath={override} overrides these; unset it")
    lines.append(f"installed {len(hooks)} hook(s) in {dst}")
    return {"ok": not override, "lines": lines}


SKIP = {"node_modules", "venv", ".venv", "target", "Library", "Pictures", "Music"}


def space_roots():
    """Where to look for spaces. $CONTOUR_SPACES overrides; otherwise the
    directory holding the toolkit, which is where spaces live by convention.

    This names where to look, not what exists — so unlike a registry it cannot
    go stale, and a space moved within a root is still found (ADR 0015).
    """
    env = os.environ.get("CONTOUR_SPACES")
    return [Path(p).expanduser() for p in env.split(":") if p] if env else [ROOT.parent]


def find_spaces(depth=4):
    """Every model space under the roots, by its marker. Bounded on purpose: a
    scan of $HOME does not finish in a usable time, a scan of one workspace is
    instant."""
    found = []
    for root in space_roots():
        if not root.is_dir():
            continue
        base = len(root.parts)
        for here, dirs, _ in os.walk(root):
            d = Path(here)
            if (d / MARKER).is_file():
                found.append(d)
                dirs[:] = []                      # spaces do not nest
                continue
            if len(d.parts) - base >= depth:
                dirs[:] = []
                continue
            dirs[:] = [x for x in dirs if not x.startswith(".") and x not in SKIP]
    return sorted(found)


def git_out(repo, *args):
    r = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def spaces(name=None):
    """List the model spaces, or print one's path for `cd $(contour spaces x)`."""
    found = find_spaces()
    if name:
        hits = [s for s in found if s.name == name]
        if len(hits) != 1:
            return {"ok": False, "lines": [f"FAIL {len(hits)} spaces named {name!r}"
                                           + (": " + ", ".join(str(h) for h in hits) if hits else "")]}
        return {"ok": True, "lines": [str(hits[0])]}
    if not found:
        return {"ok": True, "lines": [f"no model spaces under {', '.join(str(r) for r in space_roots())}",
                                      "(set $CONTOUR_SPACES to look elsewhere)"]}
    now, lines, ok = toolkit_commit(), [], True
    for s in found:
        marker = (s / MARKER).read_text()
        was = next((l.split(":", 1)[1].strip() for l in marker.splitlines()
                    if l.startswith("toolkit:")), "?")
        n = git_out(s, "rev-list", "--count", "HEAD") or "0"
        home = str(s).replace(str(Path.home()), "~")
        state = "(unknown)" if was == "?" else "(current)" if was == now else "(behind)"
        lines.append(f"  {s.name:<12} {home:<34} toolkit {was} {state:<10} {n:>4} commits")
        for r in git_out(s, "remote").split():
            lines.append(f"  WARN {s.name} has a remote ({r}) — a model space is never pushed")
            ok = False
    return {"ok": ok, "lines": lines}


def unit_tests():
    """The toolkit's own tests: stdlib unittest, no Blender, under ten seconds.

    They cover what runs outside Blender — the mark store, the canvas server,
    part identity as the canvas reads it, the launcher's own behaviour around a
    stubbed Blender. What the mask *contains* is geometry, so it is checked
    against the fixture instead, in `mask_check` below. Geometry is not
    testable this way and is not tested this way; that is what the fixture and
    the mutants below are for (ADR 0009).
    """
    r = subprocess.run([sys.executable, "-m", "unittest", "discover", "-s", "tests"],
                       cwd=str(ROOT), capture_output=True, text=True, timeout=TIMEOUT_S)
    tail = (r.stderr or r.stdout).strip().splitlines()
    ran = next((l for l in tail if l.startswith("Ran ")), "ran ?")
    return {"ok": r.returncode == 0,
            "lines": [ran] if r.returncode == 0 else tail[-12:]}


def mask_check():
    """The identity mask, read back from the fixture's own render.

    This is the one part of ADR 0018 that geometry decides, so it is checked
    where geometry is checked: against the fixture, after the render step that
    just ran, paying no second Blender startup. plinth / pillar / cap stack,
    and the cap overhangs the pillar, so the centre column is a real occlusion
    test — each pixel must name its nearest owner and nothing else.
    """
    sys.path.insert(0, str(ROOT))
    from lib import mask as mask_store
    out = ROOT / "fixtures" / "smoke" / "out"
    mpath, ppath = out / "mask.png", out / "parts.json"
    if not (mpath.exists() and ppath.exists()):
        return {"ok": False, "lines": ["no mask.png / parts.json beside the sheet"]}
    parts = json.loads(ppath.read_text())
    w, h, data = mask_store.read(mpath)
    if sorted(parts.values()) != ["cap", "pillar", "plinth"]:
        return {"ok": False, "lines": [f"parts table is {sorted(parts.values())}"]}
    if len(set(parts)) != len(parts.values()):
        return {"ok": False, "lines": ["two parts share one index"]}
    if data[0] != 0:
        return {"ok": False, "lines": [f"corner pixel is {data[0]}, not background"]}
    # Front view is the top-left quadrant; walk its centre column top to bottom.
    x, seen = w // 4, []
    for y in range(h // 2):
        name = parts.get(str(data[y * w + x]))
        if name and (not seen or seen[-1] != name):
            seen.append(name)
    if seen != ["cap", "pillar", "plinth"]:
        return {"ok": False, "lines": [f"centre column reads {seen}, "
                                       "not cap over pillar over plinth"]}
    return {"ok": True, "lines": [f"{len(parts)} parts, {w}x{h}, "
                                  f"centre column {' / '.join(seen)}"]}


def anchor_check():
    """Anchoring, against the one build whose geometry is known.

    The fixture's cap is a sphere of radius 30 mm centred on its own origin,
    sitting on the pillar. So a ray through a pixel the mask says is `cap` must
    come back naming `cap`, and the point it comes back with must be 30 mm from
    that object's origin — which is the whole claim of this slice: the mark is
    stored where it is *on the part*, not where it happened to be on a sheet.
    """
    sys.path.insert(0, str(ROOT))
    from lib import anchor, mask as mask_store
    out = ROOT / "fixtures" / "smoke" / "out"
    sheet = anchor.load(out / "views.json")
    if not sheet:
        return {"ok": False, "lines": ["no views.json beside the sheet"]}
    labels = [v["label"] for v in sheet["views"]]
    if labels != ["front", "right", "top", "persp"]:
        return {"ok": False, "lines": [f"views.json holds {labels}"]}
    if sheet["build"] != anchor.fingerprint(out / "smoke.blend"):
        return {"ok": False, "lines": ["views.json names a different build "
                                       "than the one it was rendered from"]}

    # Two marks the fixture's own mask picks out: one on the cap, one on the
    # background beside it. Written here rather than clicked, because what is
    # being checked is the ray, not the page.
    w, h, data = mask_store.read(out / "mask.png")
    table = json.loads((out / "parts.json").read_text())
    cap = [i for i, name in table.items() if name == "cap"]
    if not cap:
        return {"ok": False, "lines": ["no cap in the parts table"]}
    col = w // 4                                  # front view is the top-left tile
    rows = [y for y in range(h // 2) if data[y * w + col] == int(cap[0])]
    if not rows:
        return {"ok": False, "lines": ["the cap is not on the front view's centre column"]}
    on_cap = [col, rows[len(rows) // 2]]
    marks_path = out / "marks.json"
    marks_path.unlink(missing_ok=True)
    from lib import marks as marks_store
    hit = marks_store.append(marks_path, {"view": "front", "pixel": on_cap,
                                          "text": "is the cap too round"})["id"]
    miss = marks_store.append(marks_path, {"view": "front", "pixel": [4, 4],
                                           "text": "nothing out here"})["id"]
    rep = stage(["resolve", "smoke", "--fixture"], first=False)
    if not rep["ok"]:
        return {"ok": False, "lines": rep["lines"]}
    by_id = {m["id"]: m for m in marks_store.load(marks_path)}
    got = by_id[hit].get("anchor")
    if not got or got["part"] != "cap":
        return {"ok": False, "lines": [f"a pixel the mask calls cap anchored to {got}"]}
    if "pixel" in by_id[hit]:
        return {"ok": False, "lines": ["a resolved mark is still carrying its pixel"]}
    r = sum(c * c for c in got["local"]) ** 0.5
    if not 0.0280 <= r <= 0.0302:         # 30 mm sphere, faceted 32 x 24
        return {"ok": False, "lines": [f"the anchor sits {r * 1000:.1f} mm from the "
                                       "cap's origin, not on its 30 mm surface"]}
    if by_id[miss].get("anchor"):
        return {"ok": False, "lines": ["a click on background anchored to something"]}

    # Render again. The anchor is only worth anything if it comes back to the
    # pixel it came from, and a badge is how the user ever sees that it did.
    rep = stage(["render", "smoke", "--fixture"], first=False)
    if not rep["ok"]:
        return {"ok": False, "lines": rep["lines"]}
    drawn = next((l for l in rep["lines"] if "badge" in l), "")
    seen = re.search(rf"{hit} front (\d+),(\d+)", drawn)
    if not seen:
        return {"ok": False, "lines": [f"the re-render drew no badge for {hit}: {drawn!r}"]}
    back = [int(seen.group(1)), int(seen.group(2))]
    off = max(abs(a - b) for a, b in zip(back, on_cap))
    if off > 3:
        return {"ok": False, "lines": [f"{hit} was clicked at {on_cap} and "
                                       f"re-projects to {back}"]}
    said = agent_check(marks_path, out, w, h, data, table)
    marks_path.unlink()          # the fixture keeps no marks; the sheet keeps the badge
    if not said.startswith("agent"):
        return {"ok": False, "lines": [said]}
    return {"ok": True, "lines": [f"{len(labels)} views, build {sheet['build']}",
                                  f"cap pixel {on_cap} -> cap, "
                                  f"{r * 1000:.1f} mm from its origin",
                                  "background unresolved",
                                  f"badge back at {back}, {off} px out", said]}


def agent_check(marks_path, out, w, h, data, table):
    """An agent mark lands on its part, without anyone having clicked anything.

    The agent names a part and no point on it, so the badge's position is
    decided per view, against the identity mask: the pixel of the part nearest
    the middle of its pixels. The fixture's cap is a sphere on top of the
    pillar, so the badge must land on a pixel the mask calls `cap` — which is
    the whole claim, and one the part's *origin* would not always make.

    The fixture cannot witness the harder half: every part here is convex and
    centred on its own origin, so it cannot tell this answer from the two that
    were tried before it. That claim is made in `tests/test_agent_marks.py`
    against `anchor.nearest`, on an L (ADR 0018).

    Returns the line to report, or the sentence to fail with.
    """
    from lib import agent
    rep = agent.command(marks_path, ["--part", "cap", "is the cap too round"],
                        parts=out / "parts.json")
    if not rep["ok"]:
        return f"contour mark refused the fixture's own part: {rep['lines'][0]}"
    mid = marks_store_id(marks_path)
    rep = stage(["render", "smoke", "--fixture"], first=False)
    if not rep["ok"]:
        return "render failed with an agent mark on file"
    drawn = " | ".join(rep["lines"])
    seen = re.search(rf"{mid} front (\d+),(\d+)", drawn)
    if not seen:
        return f"no badge drawn for the agent's mark: {drawn}"
    x, y = int(seen.group(1)), int(seen.group(2))
    named = table.get(str(data[y * w + x]))
    if named != "cap":
        return (f"the agent's cap mark pinned at {[x, y]}, which the mask "
                f"calls {named!r}, not cap")
    return f"agent mark on cap, no click, badge at {[x, y]}"


def marks_store_id(path):
    """The id of the last mark on file."""
    return json.loads(path.read_text())[-1]["id"]


def stage_selftest():
    """Fixture through every stage, plus proof that verify can actually fail."""
    steps = [["build", "smoke", "--fixture"],
             ["render", "smoke", "--fixture"],
             ["export", "smoke", "--fixture"],
             ["roundtrip", "smoke", "--fixture"]]
    lines, ok, t0 = [], True, time.time()
    units = unit_tests()
    ok &= units["ok"]
    lines.append(f"{'ok  ' if units['ok'] else 'FAIL'} {'units':<10}"
                 + " | ".join(units["lines"]))
    if not units["ok"]:
        lines.insert(0, "selftest FAIL (%.1fs)" % (time.time() - t0))
        return {"ok": False, "lines": lines}
    for i, args in enumerate(steps):
        rep = stage(args, first=(i == 0))
        ok &= rep["ok"]
        shown = " | ".join(l.strip() for l in rep["lines"]) if rep["ok"] \
            else " | ".join(rep["lines"][:1] + rep["lines"][-3:])
        lines.append(f"{'ok  ' if rep['ok'] else 'FAIL'} {args[0]:<10}{shown}")
        if not rep["ok"]:
            break
        if args[0] == "render":
            mk = mask_check()
            ok &= mk["ok"]
            lines.append(f"{'ok  ' if mk['ok'] else 'FAIL'} {'mask':<10}"
                         + " | ".join(mk["lines"]))
            if not mk["ok"]:
                break
            an = anchor_check()
            ok &= an["ok"]
            lines.append(f"{'ok  ' if an['ok'] else 'FAIL'} {'anchor':<10}"
                         + " | ".join(an["lines"]))
            if not an["ok"]:
                break
    lines.insert(0, f"selftest {'PASS' if ok else 'FAIL'} ({time.time() - t0:.1f}s)")
    return {"ok": ok, "lines": lines}


